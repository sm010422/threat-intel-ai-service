# Gemini (https://aistudio.google.com/apikey 무료 발급, target-tracking-service와 동일 키 재사용 가능)
GEMINI_API_KEY=PLACEHOLDER

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Kafka - target-tracking-service와 동일한 브로커/토픽을 공유 (별도 consumer group으로 구독)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=target-tracking
KAFKA_GROUP_ID=threat-intel-ai-service
KAFKA_ENABLED=true
